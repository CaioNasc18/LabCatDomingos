# Copiar este ficheiro para .env e preencher. O .env NUNCA vai para o GitHub.

# Connection string do Neon (Dashboard → Connect). Para Django no Render,
# usar a ligação SEM "-pooler" (desligar "Connection pooling").
DATABASE_URL=postgresql://UTILIZADOR:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Gerar uma chave: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=trocar-por-uma-chave-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
