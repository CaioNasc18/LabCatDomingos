# Copiar para .env (local) ou definir em Render > Environment
# Neon > Connection Details > "Connection string" (com ?sslmode=require)
DATABASE_URL=postgresql://utilizador:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Texto longo e aleatório (não partilhar)
JWT_SEGREDO=mudar-isto-para-um-texto-longo-e-aleatorio
JWT_VALIDADE=7d
