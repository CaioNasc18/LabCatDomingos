     ]
    },
    "auth": {
     "type": "bearer",
     "bearer": [
      {
       "key": "token",
       "value": "{{token}}",
       "type": "string"
      }
     ]
    },
    "body": {
     "mode": "raw",
     "raw": "{\n  \"id_colaborador_seguinte\": 1,\n  \"id_etapa_seguinte\": 2,\n  \"observacoes\": \"Segue para impressão\"\n}"
    }
   }
  },
  {
